  "connections": {
    "Fetch": {
      "main": [
        [
          {
            "node": "Code",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Code": {
      "main": [
        [
          {
            "node": "Use",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
