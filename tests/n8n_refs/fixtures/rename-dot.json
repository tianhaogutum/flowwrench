{
  "name": "Synthetic redistributable test",
  "nodes": [
    {
      "id": "synthetic-Fetch",
      "name": "Fetch",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {}
    },
    {
      "id": "synthetic-Code",
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        0,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// $node.Fetch is an inert example\nconst note = \"$node.Fetch\";\nreturn {json: $node /* lookup */ . /* name */ Fetch.json};"
      }
    },
    {
      "id": "synthetic-Use",
      "name": "Use",
      "type": "n8n-nodes-base.set",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "text": "=outside $node.Fetch {{ $node.Fetch.json }}"
