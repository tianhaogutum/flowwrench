{
  "openapi": "3.1.0",
  "info": {
    "title": "Numeric wrapper intersections",
    "version": "1"
  },
  "servers": [
    {
      "url": "/v2"
    }
  ],
  "paths": {
    "/number": {
      "post": {
        "operationId": "sendNumber",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "number",
                "minimum": 1,
                "oneOf": [
                  {
                    "type": "number",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  {
                    "type": "number",
                    "enum": [
                      2
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/overlap": {
      "post": {
        "operationId": "overlap",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "number",
                "minimum": 1,
                "oneOf": [
                  {
                    "type": "number",
                    "enum": [
                      1
                    ]
                  },
                  {
                    "type": "number",
                    "enum": [
                      1
                    ]
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/integer": {
      "post": {
        "operationId": "sendInteger",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "integer",
                "minimum": 1,
                "maximum": 2,
                "oneOf": [
                  {
                    "type": "number"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/nested": {
      "post": {
        "operationId": "nested",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "value",
                  "values",
                  "lookup",
                  "composed"
                ],
                "additionalProperties": false,
                "properties": {
                  "value": {
                    "type": "number",
                    "minimum": 1,
                    "oneOf": [
                      {
                        "type": "number",
                        "enum": [
                          0,
                          1
                        ]
                      },
                      {
                        "type": "number",
                        "enum": [
                          2
                        ]
                      }
                    ]
                  },
                  "values": {
                    "type": "array",
                    "items": {
                      "type": "number",
                      "minimum": 1,
                      "oneOf": [
                        {
                          "type": "number",
                          "enum": [
                            0,
                            1
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            2
                          ]
                        }
                      ]
                    }
                  },
                  "lookup": {
                    "type": "object",
                    "additionalProperties": {
                      "type": "number",
                      "minimum": 1,
                      "oneOf": [
                        {
                          "type": "number",
                          "enum": [
                            0,
                            1
                          ]
                        },
                        {
                          "type": "number",
                          "enum": [
                            2
                          ]
                        }
                      ]
                    }
                  },
                  "composed": {
                    "type": "number",
                    "minimum": 2,
                    "oneOf": [
                      {
                        "type": "number",
                        "minimum": 1,
                        "oneOf": [
                          {
                            "type": "number",
                            "enum": [
                              0,
                              1
                            ]
                          },
                          {
                            "type": "number",
                            "enum": [
                              2
                            ]
                          }
                        ]
                      },
                      {
                        "type": "number",
                        "enum": [
                          4
                        ]
                      }
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/unsupported": {
      "post": {
        "operationId": "unsupported",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "number",
                "minimum": 1,
                "oneOf": [
                  {
                    "type": "number",
                    "enum": [
                      0,
                      1
                    ]
                  },
                  {
                    "type": "number",
                    "enum": [
                      2
                    ]
                  }
                ],
                "minLength": 1
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
