{
  "name": "nrflowtest",
  "version": "0.1.0",
  "description": "Offline headless flow-level tests for Node-RED",
  "license": "Apache-2.0",
  "type": "commonjs",
  "bin": {
    "nrflowtest": "bin/nrflowtest.js"
  },
  "engines": {
    "node": ">=22.9.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1",
    "test:fixture": "node bin/nrflowtest.js run --flows fixtures/orders/flows.json --tests 'fixtures/orders/*.test.yaml'",
    "test:package": "node scripts/verify-package.js"
  },
  "files": [
    "bin/",
    "lib/",
    "fixtures/orders/",
    "README.md",
    "LICENSE",
    "THIRD_PARTY.md",
    "NOTICE",
    "STATUS.json",
    "RESEARCH.md",
    "specs.json",
    "research/evidence-index.md",
    "research/dependency-audit.json",
    "npm-shrinkwrap.json",
    "test/",
    "scripts/"
  ],
  "dependencies": {
    "glob": "14.0.5",
    "node-red": "5.0.9",
    "node-red-node-test-helper": "0.3.6",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "fast-xml-parser": "5.12.0"
  },
  "overrides": {
    "body-parser": "1.20.9",
    "multer": "2.5.0",
    "npm": "11.21.2"
  }
}
